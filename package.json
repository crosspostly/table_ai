{
  "name": "youtube-podcast-generator",
  "version": "1.0.0",
  "description": "YouTube Podcast Generator - Automated video creation from images and audio",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint '**/*.{ts,js}' --ignore-pattern 'node_modules/'",
    "lint:fix": "eslint '**/*.{ts,js}' --fix --ignore-pattern 'node_modules/'",
    "validate": "npm run lint && npm run test",
    "assemble": "npm run build && node dist/assemble.js",
    "clasp:push": "cd system_integrations && clasp push",
    "clasp:pull": "cd system_integrations && clasp pull"
  },
  "keywords": [
    "youtube",
    "podcast",
    "video",
    "ffmpeg",
    "assembly",
    "typescript",
    "automation"
  ],
  "author": "crosspostly",
  "license": "ISC",
  "devDependencies": {
    "@types/google-apps-script": "^1.0.83",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.56.0",
    "eslint-config-google": "^0.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@google/clasp": "^2.4.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "services/**/*.ts",
      "!**/node_modules/**",
      "!**/dist/**"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "roots": [
      "<rootDir>/src",
      "<rootDir>/services",
      "<rootDir>/__tests__"
    ],
    "transform": {}
  }
}
