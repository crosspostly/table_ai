{
  "name": "table-ai-backend",
  "version": "1.0.0",
  "description": "Table AI Cloudflare Worker API",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787",
    "dev:node": "tsx src/server-node.ts",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute table-ai-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute table-ai-db --remote --file=./schema.sql",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hono/node-server": "^1.19.14",
    "better-sqlite3": "^12.9.0",
    "hono": "^4.2.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240320.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "typescript": "^5.4.3",
    "vitest": "^4.1.4",
    "wrangler": "^3.42.0"
  }
}
